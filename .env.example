# 复制成 .env 后按需修改；docker compose 会自动读取同目录的 .env
APP_PORT=8080

# MySQL root 密码（仅容器内部使用）
MYSQL_ROOT_PASSWORD=rootpass

# 应用连库用的账号（compose 会用这两个值创建 MySQL 用户）
APP_DB_USER=excalidraw
APP_DB_PASSWORD=excalidraw

# update：自动建表/加列；validate：只校验不修改
APP_DDL_AUTO=update

# 单次保存的 JSON 上限 / 单个附件上限（字节）
APP_MAX_SCENE_CHARS=33554432
APP_MAX_ATTACHMENT_BYTES=8388608

JAVA_OPTS=-Xms256m -Xmx512m

# 构建前端时的 npm 源
NPM_REGISTRY=https://registry.npmmirror.com
